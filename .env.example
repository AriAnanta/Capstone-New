APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=aduhh
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GEMINI_API_KEYS=
GEMINI_TIMEOUT=60
GEMINI_MODEL=gemini-2.5-flash

# OCR Configuration
# Commands for external OCR tools (optional - Tesseract will be used as fallback)
OCR_PDF_COMMAND=
OCR_IMAGE_COMMAND=
OCR_PDF_TO_IMAGE_COMMAND=

# Tesseract Configuration
# Path to Tesseract executable (Windows: "C:\\Program Files\\Tesseract-OCR\\tesseract.exe")
TESSERACT_PATH="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
# Languages for OCR (e.g., ind+eng for Indonesian and English)
TESSERACT_LANG=ind+eng
# OCR Engine Mode: 0=Legacy, 1=LSTM, 2=Legacy+LSTM, 3=Default
TESSERACT_OEM=3
# Page Segmentation Mode: 3=Automatic, 6=Single block, 11=Sparse text
TESSERACT_PSM=3

# Preprocessing Configuration
OCR_PREPROCESSING_ENABLED=true
OCR_MIN_WIDTH=1000
OCR_TARGET_WIDTH=1500
OCR_ENHANCED_TARGET_WIDTH=2000
